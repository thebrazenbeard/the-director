# Generated Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local credentials and writable state; never commit real secrets or transcripts.
!.env.example
*.sqlite3
*.sqlite3-*
*.sqlite
*.sqlite-*
# SQLite also commonly uses .db/.db3 suffixes. Keep plaintext local
# dossiers and write-ahead log sidecars out of ordinary commits.
*.db
*.db-*
*.db3
*.db3-*
config.bat
node_modules
